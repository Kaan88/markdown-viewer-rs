import { AboutSlint, Palette } from "std-widgets.slint";
import { Theme, HLine, VLine, Panel } from "theme.slint";
import { Icons, IconButton } from "icons.slint";
import { TabStrip, TabData } from "tabs.slint";
import { Tree, TreeRow, Outline, OutlineRow } from "tree.slint";
import { Splitter } from "splitter.slint";
import { FindBar } from "findbar.slint";
import { AppMenu, MenuCat, MenuEntry } from "appmenu.slint";
import { DocView, OverlayScrollbar } from "doc.slint";
export { Theme }

component SectionLabel inherits Text {
    x: 12px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.6px;
    color: Theme.text-dim;
}

export component App inherits Window {
    preferred-width: 1220px;
    preferred-height: 820px;
    min-width: 640px;
    min-height: 360px;
    title: (tabs.length > 0 ? tabs[current-tab].title + " - " : "") + "mdview look spike (Slint)";
    background: Theme.window;
    default-font-family: Theme.font;
    default-font-size: 13px;

    in property <[TabData]> tabs;
    in-out property <int> current-tab: 0;
    in property <[TreeRow]> tree-rows;
    in property <int> tree-selected: -1;
    in property <[OutlineRow]> outline-rows;
    in property <int> outline-current: 0;
    in property <image> doc-image;
    in property <int> img-w;
    in property <int> img-h;
    in property <int> img-top;
    in property <int> scroll;
    in property <int> max-scroll;
    in property <int> zoom: 100;
    in property <bool> snap: true;
    in property <bool> smooth: false;
    in property <bool> naive: false;
    in property <int> extra-w: 0;
    in property <bool> hide-overlays: false;
    in-out property <bool> left-open: true;
    in-out property <bool> right-open: true;
    in-out property <length> left-width: 230px;
    in-out property <length> right-width: 210px;
    in-out property <bool> find-open: false;
    in-out property <string> find-text: "markdown";
    in-out property <int> find-index: 2;
    out property <bool> menu-open: menu.is-open;
    in-out property <string> last-command;

    out property <int> dev-left: doc.dev-left;
    out property <int> dev-top: doc.dev-top;
    out property <int> dev-w: doc.dev-w;
    out property <int> dev-h: doc.dev-h;
    out property <int> page-x: doc.page-x;
    out property <length> logical-doc-w: doc.width;
    out property <length> logical-doc-h: doc.height;

    callback tab-select(int);
    callback tab-close(int);
    callback tree-toggle(int);
    callback tree-activate(int);
    callback outline-activate(int);
    callback scroll-delta(float);
    callback scroll-to(int);
    callback key-scroll(string);
    callback command(string);

    public function open-menu(c: int) { menu.open(c); }
    public function open-about() { about.show(); }
    public function open-context(x: length, y: length) {
        ctx-x = x;
        ctx-y = y;
        ctx.show();
    }
    public function toggle-find() {
        if find-open { close-find(); } else {
            find-open = true;
            bar.grab();
            // A popup restores the old focus as it closes, so grab again just after that.
            regrab.running = true;
        }
    }
    function close-find() {
        find-open = false;
        keys.focus();
    }

    regrab := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            bar.grab();
        }
    }

    property <length> ctx-x;
    property <length> ctx-y;
    property <int> ctx-hot: -1;
    property <[MenuCat]> cats: [
        { label: "File", items: [
            { label: "Open...", shortcut: "Ctrl+O", cmd: "open" },
            { label: "Reload", shortcut: "F5", cmd: "reload", separator-after: true },
            { label: "Close tab", shortcut: "Ctrl+W", cmd: "close-tab" },
            { label: "Quit", shortcut: "Ctrl+Q", cmd: "quit" },
        ] },
        { label: "Edit", items: [
            { label: "Copy", shortcut: "Ctrl+C", cmd: "copy" },
            { label: "Select all", shortcut: "Ctrl+A", cmd: "select-all", separator-after: true },
            { label: "Find...", shortcut: "Ctrl+F", cmd: "find" },
        ] },
        { label: "View", items: [
            { label: "Files sidebar", shortcut: "F9", cmd: "left", checked: left-open },
            { label: "Outline sidebar", shortcut: "F10", cmd: "right", checked: right-open, separator-after: true },
            { label: "Zoom in", shortcut: "Ctrl++", cmd: "zoom-in" },
            { label: "Zoom out", shortcut: "Ctrl+-", cmd: "zoom-out" },
            { label: "Actual size", shortcut: "Ctrl+0", cmd: "zoom-reset", separator-after: true },
            { label: "Switch light or dark", shortcut: "", cmd: "theme" },
        ] },
        { label: "Help", items: [
            { label: "About mdview", shortcut: "F1", cmd: "about" },
        ] },
    ];

    function run(cmd: string) {
        last-command = cmd;
        if cmd == "find" { toggle-find(); }
        else if cmd == "left" { left-open = !left-open; }
        else if cmd == "right" { right-open = !right-open; }
        else if cmd == "about" { about.show(); }
        else { root.command(cmd); }
    }

    keys := FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if e.modifiers.control && (e.text == "f" || e.text == "F") { toggle-find(); return accept; }
            if e.modifiers.control && e.text == "w" { run("close-tab"); return accept; }
            if e.modifiers.control && e.text == "q" { run("quit"); return accept; }
            if e.modifiers.control && (e.text == "+" || e.text == "=") { run("zoom-in"); return accept; }
            if e.modifiers.control && e.text == "-" { run("zoom-out"); return accept; }
            if e.modifiers.control && e.text == "0" { run("zoom-reset"); return accept; }
            if e.modifiers.alt && (e.text == "f" || e.text == "F") { menu.open(0); return accept; }
            if e.modifiers.alt && (e.text == "e" || e.text == "E") { menu.open(1); return accept; }
            if e.modifiers.alt && (e.text == "v" || e.text == "V") { menu.open(2); return accept; }
            if e.modifiers.alt && (e.text == "h" || e.text == "H") { menu.open(3); return accept; }
            if e.text == Key.F1 { run("about"); return accept; }
            if e.text == Key.F9 { run("left"); return accept; }
            if e.text == Key.F10 { run("right"); return accept; }
            if e.text == Key.Escape && find-open { close-find(); return accept; }
            if e.text == Key.PageDown { key-scroll("page-down"); return accept; }
            if e.text == Key.PageUp { key-scroll("page-up"); return accept; }
            if e.text == Key.Home { key-scroll("home"); return accept; }
            if e.text == Key.End { key-scroll("end"); return accept; }
            if e.text == Key.DownArrow { key-scroll("down"); return accept; }
            if e.text == Key.UpArrow { key-scroll("up"); return accept; }
            reject
        }

        VerticalLayout {
            top := Rectangle {
                height: 40px;
                HLine { y: parent.height - self.height; }
                HorizontalLayout {
                    padding-left: 4px;
                    padding-right: 4px;
                    VerticalLayout {
                        alignment: center;
                        menu := AppMenu {
                            cats: cats;
                            window-width: root.width;
                            window-height: root.height;
                            command(c) => { run(c); }
                            closed => { if !find-open { keys.focus(); } }
                        }
                    }
                    TabStrip {
                        horizontal-stretch: 1;
                        tabs: tabs;
                        current: current-tab;
                        select(i) => { root.tab-select(i); }
                        close(i) => { root.tab-close(i); }
                    }
                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 2px;
                            IconButton {
                                icon: Icons.search;
                                toggled: find-open;
                                clicked => { toggle-find(); }
                            }
                            IconButton {
                                icon: Icons.left-panel;
                                toggled: left-open;
                                clicked => { left-open = !left-open; }
                            }
                            IconButton {
                                icon: Icons.right-panel;
                                toggled: right-open;
                                clicked => { right-open = !right-open; }
                            }
                        }
                    }
                }
            }

            main := Rectangle {
                vertical-stretch: 1;
                property <length> l: left-open ? left-width : 0;
                property <length> r: right-open ? right-width : 0;

                if left-open: Rectangle {
                    x: 0;
                    width: l;
                    clip: true;
                    SectionLabel { y: 12px; text: "FILES"; }
                    Tree {
                        x: 0;
                        width: parent.width;
                        y: 36px;
                        height: parent.height - self.y;
                        rows: tree-rows;
                        selected-id: tree-selected;
                        toggle(id) => { root.tree-toggle(id); }
                        activate(id) => { root.tree-activate(id); }
                    }
                }

                doc := DocView {
                    x: l;
                    width: parent.width - l - r;
                    source: doc-image;
                    img-w: img-w;
                    img-h: img-h;
                    img-top: img-top;
                    snap: snap;
                    smooth: smooth;
                    naive: naive;
                    extra-w: extra-w;
                    wheel(d) => { root.scroll-delta(d); }
                    context-menu(x, y) => {
                        ctx-x = self.x + x;
                        ctx-y = self.y + y + top.height;
                        ctx.show();
                    }

                    if !hide-overlays: OverlayScrollbar {
                        x: parent.width - self.width;
                        height: parent.height;
                        scroll: scroll;
                        max-scroll: max-scroll;
                        view: dev-h;
                        request(v) => { root.scroll-to(v); }
                    }
                    bar := FindBar {
                        x: parent.width - self.width - 20px;
                        y: 8px;
                        visible: find-open && !hide-overlays;
                        query <=> find-text;
                        index: find-index;
                        next => { find-index = mod(find-index, 14) + 1; }
                        previous => { find-index = mod(find-index - 2 + 14, 14) + 1; }
                        close => { close-find(); }
                    }
                }

                if right-open: Rectangle {
                    x: parent.width - r;
                    width: r;
                    clip: true;
                    SectionLabel { y: 12px; text: "ON THIS PAGE"; }
                    Outline {
                        x: 0;
                        width: parent.width;
                        y: 36px;
                        height: parent.height - self.y;
                        rows: outline-rows;
                        current: outline-current;
                        activate(i) => { root.outline-activate(i); }
                    }
                }

                // After the panes, so the grips sit on top. The hairline stays inside the
                // sidebar: the document's edge pixel is never covered.
                if left-open: Splitter {
                    x: l - 4px - 1px;
                    height: parent.height;
                    value <=> left-width;
                }
                if right-open: Splitter {
                    x: parent.width - r - 4px;
                    height: parent.height;
                    value <=> right-width;
                    invert: true;
                    maximum: 420px;
                }
            }

            status := Rectangle {
                height: 24px;
                HLine { y: 0; }
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    Text {
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        text: tabs.length > 0 ? tabs[current-tab].path : "";
                        color: Theme.text-dim;
                        font-size: 12px;
                        overflow: elide;
                    }
                    Text {
                        vertical-alignment: center;
                        text: zoom + "%";
                        color: Theme.text-dim;
                        font-size: 12px;
                    }
                }
            }
        }
    }

    ctx := PopupWindow {
        x: ctx-x;
        y: ctx-y;
        width: 220px;
        height: 8px + 3 * 32px;
        close-policy: close-on-click-outside;
        Panel { x: 0; y: 0; width: parent.width; height: parent.height; }
        FocusScope {
            width: 0;
            height: 0;
            init => { self.focus(); ctx-hot = -1; }
            key-pressed(e) => {
                if e.text == Key.Escape { ctx.close(); keys.focus(); return accept; }
                if e.text == Key.DownArrow { ctx-hot = mod(ctx-hot + 1, 3); return accept; }
                if e.text == Key.UpArrow { ctx-hot = mod(ctx-hot + 2, 3); return accept; }
                if e.text == Key.Return && ctx-hot >= 0 {
                    run(ctx-hot == 0 ? "copy" : ctx-hot == 1 ? "select-all" : "find");
                    ctx.close();
                    if !find-open { keys.focus(); }
                    return accept;
                }
                reject
            }
        }
        VerticalLayout {
            padding: 4px;
            for it[i] in [
                { label: "Copy", cmd: "copy" },
                { label: "Select all", cmd: "select-all" },
                { label: "Find...", cmd: "find" },
            ]: Rectangle {
                height: 32px;
                border-radius: 4px;
                background: cta.has-hover || i == ctx-hot ? Theme.selected : transparent;
                Text {
                    x: 12px;
                    y: (parent.height - self.height) / 2;
                    text: it.label;
                    color: Theme.text;
                }
                cta := TouchArea {
                    clicked => {
                        run(it.cmd);
                        ctx.close();
                        if !find-open { keys.focus(); }
                    }
                }
            }
        }
    }

    about := PopupWindow {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: 420px;
        height: 300px;
        close-policy: close-on-click-outside;
        init => { Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light; }
        FocusScope {
            width: 0;
            height: 0;
            init => { self.focus(); }
            key-pressed(e) => {
                if e.text == Key.Escape { about.close(); keys.focus(); return accept; }
                accept
            }
        }
        Panel { x: 0; y: 0; width: parent.width; height: parent.height; }
        VerticalLayout {
            padding: 24px;
            spacing: 12px;
            alignment: center;
            Text {
                text: "mdview";
                font-size: 20px;
                font-weight: 600;
                color: Theme.text;
                horizontal-alignment: center;
            }
            Text {
                text: "Look spike, Slint 1.18, software renderer";
                color: Theme.text-dim;
                horizontal-alignment: center;
            }
            AboutSlint { }
        }
    }
}

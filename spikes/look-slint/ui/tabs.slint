import { Theme } from "theme.slint";
import { Icons, IconButton } from "icons.slint";

export struct TabData { title: string, path: string }

component Tab {
    in property <string> title;
    in property <bool> active;
    callback select;
    callback close;
    min-width: 96px;
    max-width: 220px;
    horizontal-stretch: 0;
    preferred-width: label.preferred-width + 12px + 8px + 24px + 4px;
    height: 32px;
    bg := Rectangle {
        y: active ? 0 : 2px;
        height: active ? parent.height + 1px : parent.height - 4px;
        border-top-left-radius: 6px;
        border-top-right-radius: 6px;
        border-bottom-left-radius: active ? 0 : 6px;
        border-bottom-right-radius: active ? 0 : 6px;
        background: active ? Theme.page : ta.has-hover ? Theme.hover : transparent;
    }
    // Behind the close button, so its own hover state wins.
    ta := TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.middle {
                root.close();
            }
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                root.select();
            }
        }
    }
    label := Text {
        x: 12px;
        y: (parent.height - self.height) / 2;
        width: min(self.preferred-width, parent.width - 12px - 8px - 24px - 4px);
        text: title;
        overflow: elide;
        color: active ? Theme.text : Theme.text-dim;
        font-weight: active ? 500 : 400;
    }
    if active || ta.has-hover: IconButton {
        x: parent.width - 24px - 4px;
        y: (parent.height - 24px) / 2;
        size: 24px;
        icon-size: 12px;
        icon: Icons.close;
        clicked => { root.close(); }
    }
    if active: Rectangle {
        x: 8px;
        y: 0;
        width: parent.width - 16px;
        height: 2px;
        border-radius: 1px;
        background: Theme.accent;
    }
}

export component TabStrip {
    in property <[TabData]> tabs;
    in property <int> current;
    callback select(int);
    callback close(int);
    height: 40px;
    HorizontalLayout {
        padding-top: 8px;
        padding-left: 4px;
        spacing: 2px;
        alignment: start;
        for t[i] in tabs: Tab {
            title: t.title;
            active: i == current;
            select => { root.select(i); }
            close => { root.close(i); }
        }
    }
}

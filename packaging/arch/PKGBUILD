# Maintainer: Kaan88 <Kaan88@users.noreply.github.com>
#
# Installs the release tarball of mdview (viewer and engine, prebuilt, linked against glibc 2.31 or newer).
# This copy keeps sha256sums=('SKIP'): a PKGBUILD kept in the repository cannot know the sum of the
# tarball of a release that does not exist yet. The release workflow uploads a PKGBUILD with the
# real sum (packaging/arch/make-pkgbuild.sh); use that one, or fill the sum in yourself.
#
#   makepkg -si
#
# The package does not update itself; pacman (or the AUR helper) does.
pkgname=mdview-bin
pkgver=0.5.0
pkgrel=1
pkgdesc="A light, fast Markdown viewer (prebuilt binary)"
arch=('x86_64')
url="https://github.com/Kaan88/markdown-viewer-rs"
license=('MIT')
depends=('glibc' 'gcc-libs' 'fontconfig' 'freetype2' 'libx11' 'libxcb')
optdepends=('curl: HTTPS requests (libcurl, loaded when present)' 'wayland: native Wayland window' 'xdg-desktop-portal: file dialogs on Wayland')
provides=("mdview=$pkgver")
conflicts=('mdview')
options=('!strip' '!debug')
source=("mdview-$pkgver-linux-x86_64.tar.gz::$url/releases/download/v$pkgver/mdview-$pkgver-linux-x86_64.tar.gz")
sha256sums=('SKIP')

package() {
    cd "$srcdir/mdview-$pkgver-linux-x86_64"
    install -Dm755 bin/mdview "$pkgdir/usr/bin/mdview"
    install -Dm755 bin/mdview-engine "$pkgdir/usr/bin/mdview-engine"
    install -Dm644 share/applications/mdview.desktop "$pkgdir/usr/share/applications/mdview.desktop"
    install -Dm644 share/icons/hicolor/256x256/apps/mdview.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/mdview.png"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

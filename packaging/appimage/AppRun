#!/bin/sh
# Entry point inside the AppImage. A bare symlink to usr/bin/mdview makes Qt take the AppDir root as
# its application directory when mounted, so it looks for plugins in the wrong place and aborts.
HERE="$(dirname "$(readlink -f "$0")")"
export QT_PLUGIN_PATH="$HERE/usr/plugins"
export XDG_DATA_DIRS="$HERE/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
exec "$HERE/usr/bin/mdview" "$@"
